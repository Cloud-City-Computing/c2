// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Login, suite mode off: the markup is unchanged > renders the login tab with OIDC offered beside local login, as before 1`] = `"<div class="modal-content"><button type="button" class="close-button" aria-label="Close">×</button><div class="login-tabs"><button class="login-tab active">Login</button></div><div class="modal-form"><label for="username">Username:</label><div class="input-with-status"><input id="username" maxlength="32" autocomplete="username" class="" type="text" value="" name="username"></div><label for="password">Password:</label><input id="password" type="password" value="" name="password"><button class="btn btn-primary stretched-button">Login</button><button class="btn btn-ghost btn-sm forgot-password-link">Forgot Password?</button><div class="oauth-divider"><span>or</span></div><a href="/api/auth/oidc/start" class="btn btn-oauth stretched-button">Sign in with SSO</a></div></div>"`;

exports[`Login, suite mode off: the markup is unchanged > renders the login tab with no OIDC and no Google, as before 1`] = `"<div class="modal-content"><button type="button" class="close-button" aria-label="Close">×</button><div class="login-tabs"><button class="login-tab active">Login</button></div><div class="modal-form"><label for="username">Username:</label><div class="input-with-status"><input id="username" maxlength="32" autocomplete="username" class="" type="text" value="" name="username"></div><label for="password">Password:</label><input id="password" type="password" value="" name="password"><button class="btn btn-primary stretched-button">Login</button><button class="btn btn-ghost btn-sm forgot-password-link">Forgot Password?</button></div></div>"`;
