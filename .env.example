# ─── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=admin
DB_PASS=changeme
DB_NAME=c2
MYSQL_ROOT_PASSWORD=changeme
# docker-compose.yaml (dev) and docker-compose-prod.yml: the host address
# MySQL's 3306 is published on. Leave blank for 127.0.0.1, which the dev server,
# `make`, a mysql client and `npm run migrate` on this machine reach. Widen it
# only on purpose: Docker's published ports sit in front of the host firewall.
DB_BIND=
# Connections the app keeps open to MySQL. Leave blank for 10. An integer from
# 1 to 100; anything else stops the server at boot with a sentence saying so.
DB_POOL_SIZE=


# ─── App ─────────────────────────────────────────────────────
# The address people use to reach this instance, scheme included. Invitation,
# password-reset and notification links are built from it. REQUIRED in
# production (NODE_ENV=production, which the Docker image sets): the server
# refuses to start without an http:// or https:// URL here, because unset it
# would email links pointing at http://localhost:3000. A localhost value (the
# one below) still boots in production, with a warning, since links then open
# only on the server itself. Behind a TLS proxy this is the public https://
# address.
APP_URL=http://localhost:3000
# Only needed to let a DIFFERENT origin call this API. Requests whose Origin
# matches the app's own Host header, or matches APP_URL above, are always
# allowed, so blank is correct for a normal self-hosted install including one
# behind a reverse proxy. Set it only for a genuinely separate front end.
CORS_ORIGIN=
# Port the app listens on. Leave blank for 3000. Set this if something else
# already owns 3000; remember to update APP_URL to match, since invitation
# and password-reset links are built from it. Under Docker this also moves the
# published mapping (docker-compose-prod.yml uses ${PORT:-3000} on both sides),
# though a port conflict on a Docker HOST is a host-side collision that PORT
# cannot resolve: Compose reports it as "port is already allocated".
PORT=
# Under Docker, the host address the app port is published on. Leave blank for
# 127.0.0.1: only this machine can reach the app, which is right for a browser
# on this machine and for a reverse proxy running here. Set 0.0.0.0 (or one
# interface's address) only to expose the port to other machines on purpose;
# production belongs behind a TLS-terminating proxy instead. See "TLS and
# reverse proxy" in docs/deployment.md.
APP_BIND=
# Which proxies to believe about the client's address (X-Forwarded-For), which
# decides req.ip and so what the rate limiters count. Leave blank to believe a
# proxy connecting from loopback or a private range (loopback, linklocal,
# uniquelocal): nginx or Caddy on this host reaching the container over the
# Docker bridge, or a cloud load balancer's private address. Any other client
# is counted by its own address, whatever header it sends. Otherwise give a
# comma list of those names, addresses and CIDRs (your proxy's address, if it
# is public or you want only it believed), or `false` to believe none. A hop
# count (1, 2, ...) or `true` stops the server at boot: either believes the
# header from whoever connects, so any client that can reach the port directly
# picks its own address and steps around the limits. So does a range wide
# enough to take in public addresses (wider than an IPv4 /8, wider than an
# IPv6 /16 outside fc00::/7 and fe80::/10, or ::ffff:0:0/96, which is every
# IPv4 address), an entry not written as a name or a standard address (010.0.0.0
# is read as octal), and a value Express cannot parse.
TRUST_PROXY=
# Set to true only to accept a hop count, `true` or a public-sized range in
# TRUST_PROXY anyway, knowing that any client that can reach the app's port
# can then choose its own address. Blank or false refuses them; anything else
# stops the boot.
TRUST_PROXY_ALLOW_HOP_COUNT=

# ─── SMTP (optional) ────────────────────────────────────────
# Leave blank to run without email. The app boots either way.
# With email disabled: invitations return a copyable link in the admin UI,
# password reset is unavailable, and email-based 2FA cannot be enabled
# (authenticator-app TOTP setup still works, showing its QR code in the
# app instead of emailing it).
# Turning email OFF on an instance that already had it locks out anyone
# already using email 2FA (their login code cannot be delivered), and stops
# anyone disabling 2FA at all, since that confirmation is emailed for TOTP
# accounts too. There is no admin-side 2FA reset yet.
# The capability is decided once at boot: changes here need a restart.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── Admin (required — super user credentials) ──────────────
# Every boot creates this admin, or resets an existing admin's email and
# password to these values. It never promotes an existing non-admin account
# with this name or email: it logs a refusal instead (docs/deployment.md).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ─── Google OAuth / SSO (optional) ──────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set authorized redirect URI to: <APP_URL>/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict sign-in to a specific Google Workspace domain (e.g. yourcompany.com)
# When set, users from this domain can sign in and auto-create accounts without an invitation.
# Leave blank to allow any Google account to link to existing accounts only.
GOOGLE_OAUTH_DOMAIN=

# ─── Sign-in providers (optional, leave unset) ──────────────
# Which sign-in methods this instance offers. Leave unset: the default is local
# (username and password) always, plus google when both Google variables above
# are set. If you do set it, it is a comma list of local and google, it must
# include local, and it must agree with the Google variables: the server refuses
# to start on an unknown name, on google without GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET, or on a list that leaves out a configured google.
AUTH_PROVIDERS=

# ─── GitHub Integration (optional) ──────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Set authorization callback URL to: <APP_URL>/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Service Token (optional, machine access) ───────────────
# A machine credential for another service that needs to read this install's
# documents: GET /api/search and GET /api/browse, and nothing else. Both
# variables are required; set neither and no new authentication path exists.
# Present it exactly like a session token: Authorization: Bearer <SERVICE_TOKEN>
#
# The secret itself. Must be at least 32 characters or the feature stays off
# (a warning is logged at first use). Generate one with:
#   openssl rand -hex 32
# Rotating it is immediate and needs no database change, but any caller still
# holding the old value starts getting 401s.
SERVICE_TOKEN=
# The email of an EXISTING, NON-ADMIN user whose access the token acts with.
# The token sees exactly what that user sees, through the normal archive ACLs,
# so grant it access the ordinary way: put the user in the squads, or on the
# archive grants, it should be able to read. An admin here is refused outright
# and logged, because an admin principal matches every archive in the install.
SERVICE_TOKEN_USER=

# ─── Runtime ─────────────────────────────────────────────────
# 'production' allows the app's own origin plus CORS_ORIGIN. Anything else also
# allows localhost on any port, so the Vite dev server can call the API.
# Leave unset for development; `npm run start` and the Docker image set it.
NODE_ENV=
